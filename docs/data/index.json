  {
   "key": "INDEP",
   "label": "Independent per-source",
   "note": "same model, cross-source information flow removed, anchors withheld"
  },
  {
   "key": "RULE",
   "label": "Rule solver",
   "note": "constraint optimisation over the declared relations"
  },
  {
   "key": "LLM",
   "label": "LLM-direct",
   "note": "qwen3:8b emits keyframes from the prompt text"
  }
 ],
